#!/usr/bin/env python3
"""Fake twib for the tests: answers from botbase_sim's control port.

    twib -P <socket> connect-tcp <ip> | ps | terminate <pid> | launch <tid> <storage>

Needs $COLDSTART_SIM_CTL=host:port. The twibd socket given with -P must exist
(start the fake twibd next to this script). Behaviour switches:

    FAKE_TWIB_PROCESS=present|absent   force the hbloader row in or out of ps
    FAKE_TWIB_TERMINATE=fail           terminate fails (process stays)
    FAKE_TWIB_LOG=<file>               append every invocation to this file
"""
import json
import os
import socket
import sys

HBL = 0x01007EF00011E000


def ctl(req):
    host, _, port = os.environ["COLDSTART_SIM_CTL"].rpartition(":")
    with socket.create_connection((host, int(port)), timeout=5) as s:
        s.sendall((json.dumps(req) + "\n").encode())
        f = s.makefile("rb")
        return json.loads(f.readline())


def main(argv):
    if os.environ.get("FAKE_TWIB_LOG"):
        with open(os.environ["FAKE_TWIB_LOG"], "a") as fh:
            fh.write(" ".join(argv) + "\n")
    sock = None
    if len(argv) >= 2 and argv[0] == "-P":
        sock, argv = argv[1], argv[2:]
    if not argv:
        print("usage: twib [-P socket] <command>", file=sys.stderr)
        return 2
    if sock is None or not os.path.exists(sock):
        print(f"[ERROR] could not connect to twibd at {sock}", file=sys.stderr)
        return 1
    cmd = argv[0]
    if cmd == "connect-tcp":
        r = ctl({"cmd": "connect"})
        if not r["ok"]:
            print(f"[ERROR] failed to connect to {argv[1] if len(argv) > 1 else '?'}: {r['error']}",
                  file=sys.stderr)
            return 1
        return 0
    if cmd == "ps":
        r = ctl({"cmd": "ps"})
        if not r.get("devices"):
            print("No devices were detected.")
            return 1
        procs = r["procs"]
        force = os.environ.get("FAKE_TWIB_PROCESS", "")
        if force == "absent":
            procs = [p for p in procs if p["tid"] != HBL]
        elif force == "present" and not any(p["tid"] == HBL for p in procs):
            procs.append({"pid": 0x97, "tid": HBL, "name": "hbloader"})
        print("Process ID | Result | Title ID           | Process Name | MMU Flags")
        for p in procs:
            print(f"{hex(p['pid']):<10} | 0x0    | {hex(p['tid']):<18} | {p['name']:<12} | 0x77")
        return 0
    if cmd == "terminate" and len(argv) == 2:
        if os.environ.get("FAKE_TWIB_TERMINATE") == "fail":
            print("[ERROR] remote error: 0xf601", file=sys.stderr)
            return 1
        r = ctl({"cmd": "terminate", "pid": int(argv[1], 0)})
        if not r["ok"]:
            print(f"[ERROR] {r['error']}", file=sys.stderr)
            return 1
        return 0
    if cmd == "launch" and len(argv) == 3:
        r = ctl({"cmd": "launch", "tid": argv[1], "storage": argv[2]})
        if not r["ok"]:
            print(f"[ERROR] {r['error']}", file=sys.stderr)
            return 1
        print("Process ID: 0x85")
        return 0
    print(f"fake twib: unsupported command {' '.join(argv)}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
